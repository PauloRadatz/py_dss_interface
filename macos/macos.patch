# macOS arm64 build patch for OpenDSSC (VersionC.zip).
# Authored against epri-dev/OpenDSS-C SVN r4133 (see OpenDSSC_Commit.txt).
#
# Apply with: patch -p1 -d <unzipped-VersionC-dir> < macos/macos.patch
#
# Adds an Apple branch to CMakeLists; gates Linux-only headers (<linux/stat.h>,
# <linux/unistd.h>, <error.h>) behind #ifndef __APPLE__; replaces glibc-only
# calls (FpReadLink("/proc/self/exe"), strerror_l, syscall(SYS_exit_group),
# __errno_location, __LC_ALL/__LC_TIME, _NL_MONETARY_CRNCYSTR) with the macOS
# equivalents (_NSGetExecutablePath, strerror, _exit, errno, LC_ALL, default
# values); rewrites Fpopendir/Fpreaddir/Fpclosedir to use opendir/readdir on
# Apple since macOS lacks SYS_getdents64; replaces xdg-open with open in
# Show_COM_Help; allows pointer storage in TSearchRec on Apple.
#
# Implements the missing RelaysV variant cases 1-4 (State/NormalState read/
# write per-phase array). The upstream RelaysV only handled case 0
# (AllNames); cases 1-4 fell through to the default branch returning
# "Error, parameter not recognized". Cross-platform bug; surfaces on the
# C++ backend (Linux/macOS) since Windows defaults to the Delphi backend.
#
# Renames Recloser PropertyName[12]/[13] from "PhInst"/"GndInst" to
# "PhaseInst"/"GroundInst". The bundled VersionC.zip uses the short names;
# the Python tests, the OpenDSS Delphi backend, and the OpenDSSCDLL wrapper
# all use the long names. Without the alias, "New Recloser ... PhaseInst=2400"
# is parsed as an unknown property and silently ignored, leaving PhInst at
# its default 0.0 -- which is why test_reclosers_read_phase_inst returned 0.0
# on macOS-C++ but 2400 on Windows-Delphi. The struct field name (PhInst)
# stays unchanged; only the property keyword the parser recognizes moves.
#
# The CMake APPLE branch additionally defines linux=1 and __linux__=1 to enable
# the existing POSIX code paths gated by those macros, and
# _LIBCPP___FWD_COMPLEX_H to suppress libc++'s forward declaration of
# std::complex (which would otherwise conflict with Ucomplex::complex via the
# project's using-directives).
#
diff -urN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-05-03 11:09:57
+++ b/CMakeLists.txt	2026-05-03 11:09:58
@@ -298,10 +298,36 @@
 		${CMAKE_THREAD_LIBS_INIT}
 		${KLUSOLVE_LIB}
 	)
+elseif(APPLE)
+	# macOS: libc++ already provides std::filesystem, libSystem already provides
+	# dlopen, and uuid lives in the SDK.  None of stdc++fs/dl/uuid need to be linked.
+	# Define linux/__linux__ so the existing POSIX code paths (guarded by
+	# `#ifdef linux` and `#elif __linux__`) compile.  Truly Linux-only items
+	# (`<linux/stat.h>`, `/proc/self/exe`, `exit_group`) are additionally
+	# guarded with `#ifndef __APPLE__` in the source.
+	#
+	# _LIBCPP___FWD_COMPLEX_H pre-defines libc++'s internal include guard for
+	# <__fwd/complex.h>, suppressing libc++'s forward declaration of
+	# std::complex that <vector> et al pull in transitively.  Without this the
+	# project's Ucomplex::complex and std::complex are both visible to
+	# unqualified `complex` lookup wherever both `using namespace Ucomplex` and
+	# `using namespace std` are in effect, which breaks compilation in many
+	# headers and translation units.  libstdc++ (Linux) does not publish the
+	# forward declaration so the issue does not manifest there.
+	add_compile_definitions(linux=1 __linux__=1 _LIBCPP___FWD_COMPLEX_H)
+	# Apple Clang treats passing a std::string through a variadic function as an
+	# error by default; GCC only warns.  The Format(...) call sites in
+	# Recloser.cpp et al rely on the lenient GCC behavior; downgrade the
+	# diagnostic on macOS until those call sites are migrated to .c_str().
+	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-non-pod-varargs")
+	set(OPENDSSC_COMMON_LIBS
+		${CMAKE_THREAD_LIBS_INIT}
+		${KLUSOLVE_LIB}
+	)
 else()
 	# Linux
 	# NOTE: iconv seems to be required on some recent compilers.
-	#       From the GCC bugtracker and tickets from other projects, 
+	#       From the GCC bugtracker and tickets from other projects,
 	#       it could be a bug in the compiler setup, but linking iconv
 	#		is enough to work around it.
 	set(OPENDSSC_COMMON_LIBS
